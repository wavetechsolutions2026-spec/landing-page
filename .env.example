# Copy to .env and fill in real values. Never commit real secrets.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Sender. "Name <onboarding@resend.dev>" works for testing but only delivers to the
# Resend account owner. For production, use an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# Sanity (public; these defaults are also built into src/sanity/env.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=8o8c9vqq
NEXT_PUBLIC_SANITY_DATASET=production
